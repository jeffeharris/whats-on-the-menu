PORT=5173
VITE_FEATURE_SHARED_MENUS=false

# Optional public site token for cookie-free Cloudflare Web Analytics on the
# logged-out landing page. This is the site token from the beacon snippet, not
# a Cloudflare API token. Analytics stays disabled when it is unset.
# VITE_CLOUDFLARE_WEB_ANALYTICS_TOKEN=your_32_character_site_token

# Optional tip-jar link shown in the landing footer + Settings (hidden if unset)
# VITE_SUPPORT_URL=https://buymeacoffee.com/yourhandle

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsonthemenu

# Server-side API keys (not exposed to client)
RUNWARE_API_KEY=your_runware_api_key_here

# AI image generation cost controls (all optional — defaults shown)
# RUNWARE_MODEL=runware:z-image@turbo       # model used for every generation
# IMAGE_GEN_DAILY_LIMIT_HOUSEHOLD=50        # images per household per rolling 24h
# IMAGE_GEN_DAILY_LIMIT_GLOBAL=1000         # images across all households per rolling 24h
# IMAGE_GEN_ENABLED=false                   # kill switch: stops all paid generation

# Auth
RESEND_API_KEY=
APP_URL=http://localhost:5173
